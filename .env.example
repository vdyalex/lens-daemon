# Required
ANTHROPIC_API_KEY=sk-ant-xxxxx
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Optional (defaults shown)
# File path for subscriber list (tracking users who sent /start)
SUBSCRIBER_STORE_PATH=tmp/subscribers
LOG_LEVEL=debug
CLAUDE_MODEL=claude-sonnet-4-6
SYSTEM_PROMPT="You're a questionnaire assistant. Provide quick, accurate responses with maximum efficiency.\n\nFor each question:\n1. Identify the correct answer\n2. Provide a brief, logical explanation."

# Hotkey configuration (macOS key names, defaults shown)
# Supported values: LeftShift, RightShift, LeftControl, RightControl, LeftCommand, RightCommand, LeftOption, RightOption, Fn
HOTKEY_TRIGGER_KEYNAME=RightShift
HOTKEY_BOUNDS_KEYNAME=RightOption
