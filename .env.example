# ─────────────────────────────────────────────────────────────────────────────
# Anthropic AI
# ─────────────────────────────────────────────────────────────────────────────

# Required. Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Anthropic model ID.
# Default: claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# System prompt sent with each API request.
ANTHROPIC_SYSTEM_PROMPT="You're a questionnaire assistant. Provide quick, accurate responses with maximum efficiency."

# Maximum tokens per API response.
# Default: 1024
ANTHROPIC_MAX_RESPONSE_TOKENS=1024

# Bot token from @BotFather. When absent, Telegram broadcasting is disabled.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# File path for the subscriber list (persists users who sent /start).
# Default: tmp/subscribers
SUBSCRIBER_STORE_PATH=tmp/subscribers

# Maximum runes per Telegram message (auto-splits longer responses).
# Default: 4096
TELEGRAM_MESSAGE_CHUNK_SIZE=4096

# Retry attempts on Telegram rate limit (HTTP 429).
# Default: 1
TELEGRAM_MAX_RETRIES=1

# Server-side long-poll timeout for Telegram updates.
# Default: 30s
TELEGRAM_LONG_POLL_TIMEOUT=30s

# Client-side timeout for Telegram poller (should exceed long-poll timeout).
# Default: 35s
TELEGRAM_POLLER_TIMEOUT=35s

# Per-request HTTP timeout. 0 disables (context timeout is the bound).
# Default: 0
TELEGRAM_HTTP_CLIENT_TIMEOUT=0

# Deadline for broadcasting to all subscribers.
# Default: 30s
TELEGRAM_BROADCAST_TIMEOUT=30s

# ─────────────────────────────────────────────────────────────────────────────
# Hotkey configuration
# ─────────────────────────────────────────────────────────────────────────────
# Supported values: LeftShift, RightShift, LeftControl, RightControl,
#                   LeftCommand, RightCommand, LeftOption, RightOption, Fn

# Hotkey to trigger screen capture.
# Default: RightShift
HOTKEY_TRIGGER_KEYNAME=RightShift

# Hotkey to define custom capture bounds (hold + move mouse).
# While held: arrow keys reposition teleprompter, -/+ adjust text opacity, 0 resets opacity.
# Default: RightOption
HOTKEY_BOUNDS_KEYNAME=RightOption

# Hotkey to toggle teleprompter overlay visibility.
# Default: RightCommand
HOTKEY_TOGGLE_KEYNAME=RightCommand

# ─────────────────────────────────────────────────────────────────────────────
# Vision / OCR
# ─────────────────────────────────────────────────────────────────────────────

# Vision language (BCP 47 code).
# Default: en-US
VISION_LANG=en-US

# Vision accuracy level.
# Values: accurate, fast
# Default: accurate
VISION_ACCURACY=accurate

# ─────────────────────────────────────────────────────────────────────────────
# Teleprompter appearance
# ─────────────────────────────────────────────────────────────────────────────

# Font family name. Empty uses the system font.
# Examples: Menlo, Helvetica Neue, SF Mono
# Default: (system font)
TELEPROMPTER_FONT_FAMILY=

# Font weight.
# Values: ultralight, thin, light, regular, medium, semibold, bold, heavy, black
# Default: ultralight
TELEPROMPTER_FONT_WEIGHT=ultralight

# Font size in points.
# Default: 14.0
TELEPROMPTER_FONT_SIZE=14.0

# Text opacity (0.0 = invisible, 1.0 = fully opaque).
# Adjustable at runtime: hold bounds hotkey + minus/plus (+-0.01), 0 resets to default.
# Default: 0.05
TELEPROMPTER_OPACITY=0.05

# Initial visibility on startup.
# Values: true, false
# Default: false
TELEPROMPTER_VISIBLE=false

# Text alignment. "dynamic" adapts based on grid column position.
# Values: left, center, right, dynamic
# Default: dynamic
TELEPROMPTER_ALIGNMENT=dynamic

# Per-pixel adaptive text color. Captures background behind the overlay, inverts it,
# and uses the result as the text color so each pixel contrasts with whatever is beneath it.
# Values: true, false
# Default: true
TELEPROMPTER_ADAPTIVE_COLOR=true

# Fade animation duration in seconds for show/hide/text updates. Set to 0 to disable.
# Default: 0.75
TELEPROMPTER_FADE_DURATION=0.75

# ─────────────────────────────────────────────────────────────────────────────
# Pipeline timeouts
# ─────────────────────────────────────────────────────────────────────────────

# Total deadline for a complete capture-to-broadcast cycle.
# Default: 5m
TIMEOUT_PIPELINE_OVERALL=5m

# Deadline for detecting the active window via AppleScript.
# Default: 5s
TIMEOUT_FOREGROUND_WINDOW=5s

# Deadline for taking a screenshot.
# Default: 30s
TIMEOUT_CAPTURE=30s

# Deadline for OCR text extraction via Vision framework.
# Default: 30s
TIMEOUT_OCR_EXTRACT=30s

# Deadline for Claude AI API call and response.
# Default: 60s
TIMEOUT_AI_PROCESS=60s

# Total deadline for Phase 1 (window detection + screenshot).
# Default: 40s
TIMEOUT_CAPTURE_PHASE=40s

# Total deadline for Phase 2 (OCR + AI + broadcast).
# Default: 5m
TIMEOUT_ANALYSE_PHASE=5m

# ─────────────────────────────────────────────────────────────────────────────
# Grid positioning
# ─────────────────────────────────────────────────────────────────────────────

# Percentage step per arrow-key press (0.0–1.0). Smaller = finer positioning.
# Default: 0.01
GRID_STEP=0.01

# Initial horizontal position (0.0 = left edge, 1.0 = right edge).
# Default: 0.5
GRID_INITIAL_COL=0.5

# Initial vertical position (0.0 = top edge, 1.0 = bottom edge).
# Default: 0.5
GRID_INITIAL_ROW=0.5

# Idle delay after the last arrow press before the teleprompter repositions.
# Rapid presses extend the timer, preventing visible jumps.
# Default: 300ms
GRID_MOVE_DEBOUNCE_DURATION=300ms

# How often the pipeline checks if the captured window moved or resized.
# Uses CGWindowListCopyWindowInfo (metadata only, no screen-capture indicator).
# Default: 200ms
WINDOW_MONITOR_INTERVAL=200ms

# How long the window must stay still before the teleprompter restores.
# Default: 500ms
WINDOW_STABILIZE_DELAY=500ms

# ─────────────────────────────────────────────────────────────────────────────
# Advanced
# ─────────────────────────────────────────────────────────────────────────────

# CFRunLoop polling interval for keyboard event detection.
# Default: 500ms
EVENT_TAP_POLL_INTERVAL=500ms

# Buffer size for Phase 2 analyse queue.
# Default: 5
ANALYSE_QUEUE_CAPACITY=5

# Minimum log level.
# Values: debug, info, warn, error
# Default: info
LOG_LEVEL=info
